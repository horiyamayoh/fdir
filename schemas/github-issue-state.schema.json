{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/horiyamayoh/fdir/schemas/github-issue-state.schema.json/1.0.0",
  "title": "FDIR verified GitHub issue-state snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "repository", "sourceSha", "retrievedAt", "expiresAt", "maxAgeSeconds", "retrievedBy", "retrieval", "ci", "issues", "responseDigest", "snapshotDigest"],
  "properties": {
    "schema": {"const": "fdir/github-issue-state"},
    "version": {"const": "1.0.0"},
    "repository": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
    "sourceSha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "retrievedAt": {"type": "string", "format": "date-time"},
    "expiresAt": {"type": "string", "format": "date-time"},
    "maxAgeSeconds": {"type": "integer", "minimum": 1, "maximum": 3600},
    "retrievedBy": {"type": "string", "minLength": 1},
    "retrieval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "apiBaseUrl", "apiVersion", "userAgent"],
      "properties": {
        "method": {"const": "GET"},
        "apiBaseUrl": {"type": "string", "format": "uri", "pattern": "^https://"},
        "apiVersion": {"const": "2022-11-28"},
        "userAgent": {"type": "string", "minLength": 1},
        "actor": {"type": "string", "minLength": 1}
      }
    },
    "ci": {"$ref": "#/$defs/ci"},
    "issues": {
      "type": "array",
      "minItems": 25,
      "maxItems": 25,
      "prefixItems": [
        {"allOf": [{"$ref": "#/$defs/issue"}, {"properties": {"issueNumber": {"const": 87}}}]},
        {"allOf": [{"$ref": "#/$defs/issue"}, {"properties": {"issueNumber": {"const": 88}}}]},
        {"allOf": [{"$ref": "#/$defs/issue"}, {"properties": {"issueNumber": {"const": 89}}}]},
        {"allOf": [{"$ref": "#/$defs/issue"}, {"properties": {"issueNumber": {"const": 90}}}]},
        {"allOf": [{"$ref": "#/$defs/issue"}, {"properties": {"issueNumber": {"const": 91}}}]},
        {"allOf": [{"$ref": "#/$defs/issue"}, {"properties": {"issueNumber": {"const": 92}}}]},
        {"allOf": [{"$ref": "#/$defs/issue"}, {"properties": {"issueNumber": {"const": 93}}}]},
        {"allOf": [{"$ref": "#/$defs/issue"}, {"properties": {"issueNumber": {"const": 94}}}]},
        {"allOf": [{"$ref": "#/$defs/issue"}, {"properties": {"issueNumber": {"const": 95}}}]},
        {"allOf": [{"$ref": "#/$defs/issue"}, {"properties": {"issueNumber": {"const": 96}}}]},
        {"allOf": [{"$ref": "#/$defs/issue"}, {"properties": {"issueNumber": {"const": 97}}}]},
        {"allOf": [{"$ref": "#/$defs/issue"}, {"properties": {"issueNumber": {"const": 98}}}]},
        {"allOf": [{"$ref": "#/$defs/issue"}, {"properties": {"issueNumber": {"const": 99}}}]},
        {"allOf": [{"$ref": "#/$defs/issue"}, {"properties": {"issueNumber": {"const": 100}}}]},
        {"allOf": [{"$ref": "#/$defs/issue"}, {"properties": {"issueNumber": {"const": 101}}}]},
        {"allOf": [{"$ref": "#/$defs/issue"}, {"properties": {"issueNumber": {"const": 102}}}]},
        {"allOf": [{"$ref": "#/$defs/issue"}, {"properties": {"issueNumber": {"const": 103}}}]},
        {"allOf": [{"$ref": "#/$defs/issue"}, {"properties": {"issueNumber": {"const": 104}}}]},
        {"allOf": [{"$ref": "#/$defs/issue"}, {"properties": {"issueNumber": {"const": 105}}}]},
        {"allOf": [{"$ref": "#/$defs/issue"}, {"properties": {"issueNumber": {"const": 108}}}]},
        {"allOf": [{"$ref": "#/$defs/issue"}, {"properties": {"issueNumber": {"const": 109}}}]},
        {"allOf": [{"$ref": "#/$defs/issue"}, {"properties": {"issueNumber": {"const": 110}}}]},
        {"allOf": [{"$ref": "#/$defs/issue"}, {"properties": {"issueNumber": {"const": 111}}}]},
        {"allOf": [{"$ref": "#/$defs/issue"}, {"properties": {"issueNumber": {"const": 112}}}]},
        {"allOf": [{"$ref": "#/$defs/issue"}, {"properties": {"issueNumber": {"const": 113}}}]}
      ],
      "items": {"$ref": "#/$defs/issue"}
    },
    "responseDigest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "snapshotDigest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "$defs": {
    "ci": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "repository", "sourceSha", "runId", "attempt", "job"],
      "properties": {
        "provider": {"enum": ["github-actions", "local"]},
        "repository": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
        "sourceSha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "runId": {"type": "string", "minLength": 1},
        "attempt": {"type": "integer", "minimum": 1},
        "job": {"type": "string", "minLength": 1}
      }
    },
    "issue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["issueNumber", "state", "stateReason", "closedAt", "updatedAt", "apiUrl", "url", "etag", "responseDigest"],
      "properties": {
        "issueNumber": {"type": "integer", "minimum": 87, "maximum": 113, "enum": [87, 88, 89, 90, 91, 92, 93, 94, 95, 96, 97, 98, 99, 100, 101, 102, 103, 104, 105, 108, 109, 110, 111, 112, 113]},
        "state": {"enum": ["open", "closed"]},
        "stateReason": {"type": ["string", "null"], "enum": ["completed", "not_planned", "duplicate", "reopened", null]},
        "closedAt": {"type": ["string", "null"], "format": "date-time"},
        "updatedAt": {"type": "string", "format": "date-time"},
        "apiUrl": {"type": "string", "format": "uri", "pattern": "^https://"},
        "url": {"type": "string", "format": "uri"},
        "etag": {"type": ["string", "null"], "minLength": 1},
        "responseDigest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
