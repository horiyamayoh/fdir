{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/horiyamayoh/fdir/schemas/qualification-issue-105-report.schema.json",
  "title": "FDIR issue 105 qualification report",
  "type": "object",
  "required": ["schema", "version", "issueNumber", "reportName", "sourceSha", "dirtyTree", "status", "assertions", "cases"],
  "properties": {
    "schema": {"const": "fdir/qualification-issue-105-report"},
    "version": {"const": "1.0.0"},
    "issueNumber": {"const": 105},
    "reportName": {"enum": ["requirement-traceability.json", "behavioral-suite-inventory.json", "cli-api-contract-results.json", "platform-runtime-matrix.json", "fresh-install-results.json", "determinism-replay-diff.json", "false-completion-regressions.json", "release-claim-conformance.json"]},
    "sourceSha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "dirtyTree": {"type": "boolean"},
    "status": {"enum": ["passed", "failed"]},
    "completionStatus": {"enum": ["qualified", "incomplete"]},
    "assertions": {"type": "array", "items": {"$ref": "#/$defs/assertion"}},
    "cases": {"type": "array", "items": {"$ref": "#/$defs/case"}},
    "diagnostics": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "assertion": {
      "type": "object",
      "required": ["id", "expected", "actual", "status"],
      "properties": {"id": {"type": "string", "minLength": 1}, "status": {"enum": ["passed", "failed"]}}
    },
    "case": {
      "type": "object",
      "required": ["caseId", "oracle", "assertionIds", "target", "expected", "actual", "inputDigest", "status"],
      "properties": {
        "caseId": {"type": "string", "minLength": 1},
        "oracle": {"type": "string", "minLength": 1},
        "assertionIds": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "target": {"type": "string", "minLength": 1},
        "inputDigest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "status": {"enum": ["passed", "failed"]}
      }
    }
  }
}
