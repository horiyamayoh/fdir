{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/horiyamayoh/fdir/schemas/qualification-evidence.schema.json/1.0.0",
  "title": "FDIR qualification Evidence object",
  "description": "Commit-bound, digest-bound execution evidence for a qualification bundle.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "evidenceId",
    "issueNumbers",
    "requirementIds",
    "sourceSha",
    "dirtyTree",
    "generatedAt",
    "generator",
    "command",
    "workingDirectory",
    "environment",
    "inputs",
    "outputs",
    "assertions",
    "testCases",
    "status",
    "failureCount",
    "waivers",
    "ci"
  ],
  "properties": {
    "schema": {
      "const": "fdir/qualification-evidence"
    },
    "version": {
      "const": "1.0.0"
    },
    "evidenceId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "issueNumbers": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "integer",
        "minimum": 1
      }
    },
    "requirementIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
      }
    },
    "sourceSha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "dirtyTree": {
      "type": "boolean"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "generator": {
      "type": "string",
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^/\\\\]+(?:/[^/\\\\]+)*$"
    },
    "command": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "workingDirectory": {
      "type": "string",
      "pattern": "^(?:\\.|(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^/\\\\]+(?:/[^/\\\\]+)*)$"
    },
    "environment": {
      "$ref": "#/$defs/environment"
    },
    "inputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/input"
      }
    },
    "outputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/output"
      }
    },
    "assertions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/assertion"
      }
    },
    "testCases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/testCase"
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "passed",
        "failed",
        "blocked"
      ]
    },
    "failureCount": {
      "type": "integer",
      "minimum": 0
    },
    "waivers": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/waiver"
      }
    },
    "ci": {
      "$ref": "#/$defs/ci"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "repositoryPath": {
      "type": "string",
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^/\\\\]+(?:/[^/\\\\]+)*$"
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "os",
        "architecture",
        "python",
        "runtime",
        "dependencyLockDigest"
      ],
      "properties": {
        "os": {
          "type": "string",
          "minLength": 1
        },
        "architecture": {
          "type": "string",
          "minLength": 1
        },
        "python": {
          "type": "string",
          "minLength": 1
        },
        "runtime": {
          "type": "string",
          "minLength": 1
        },
        "dependencyLockDigest": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "role"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/repositoryPath"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "role": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "mediaType",
        "sha256",
        "role"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/repositoryPath"
        },
        "mediaType": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "role": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "supportingOutput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "lineStart",
        "lineEnd"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/repositoryPath"
        },
        "lineStart": {
          "type": "integer",
          "minimum": 1
        },
        "lineEnd": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "assertion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assertionId",
        "expected",
        "actual",
        "status",
        "supportingOutput"
      ],
      "properties": {
        "assertionId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "expected": {},
        "actual": {},
        "status": {
          "type": "string",
          "enum": [
            "passed",
            "failed"
          ]
        },
        "supportingOutput": {
          "$ref": "#/$defs/supportingOutput"
        }
      }
    },
    "testCase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "caseId",
        "oracle",
        "inputDigest",
        "result"
      ],
      "properties": {
        "caseId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "oracle": {
          "type": "string",
          "minLength": 1
        },
        "inputDigest": {
          "$ref": "#/$defs/sha256"
        },
        "result": {
          "type": "string",
          "enum": [
            "passed",
            "failed",
            "skipped"
          ]
        }
      }
    },
    "waiver": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "waiverId",
        "reason",
        "approvedBy"
      ],
      "properties": {
        "waiverId": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "approvedBy": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "ci": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "repository",
        "sourceSha",
        "runId",
        "runUrl",
        "jobId",
        "attempt",
        "status"
      ],
      "properties": {
        "provider": {
          "type": "string",
          "enum": [
            "github-actions",
            "local"
          ]
        },
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "sourceSha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "runId": {
          "type": "string",
          "minLength": 1
        },
        "runUrl": {
          "type": "string",
          "minLength": 1
        },
        "jobId": {
          "type": "string",
          "minLength": 1
        },
        "attempt": {
          "type": "integer",
          "minimum": 1
        },
        "status": {
          "type": "string",
          "enum": [
            "completed",
            "in_progress",
            "cancelled",
            "skipped"
          ]
        }
      }
    }
  }
}
