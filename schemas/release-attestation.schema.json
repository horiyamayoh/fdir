{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/horiyamayoh/fdir/schemas/release-attestation.schema.json/1.0.0",
  "title": "FDIR final release attestation",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "repository", "sourceSha", "generatedAt", "phase", "bundle", "issueState", "releaseState", "ci", "supplyChain", "closure", "attestationDigest"],
  "properties": {
    "schema": {"const": "fdir/release-attestation"},
    "version": {"const": "1.0.0"},
    "repository": {"const": "horiyamayoh/fdir"},
    "sourceSha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "generatedAt": {"type": "string", "format": "date-time"},
    "phase": {"const": "final"},
    "bundle": {"$ref": "#/$defs/bundle"},
    "issueState": {
      "allOf": [
        {"$ref": "https://github.com/horiyamayoh/fdir/schemas/github-issue-state.schema.json/1.0.0"},
        {"$ref": "#/$defs/finalIssueState"}
      ]
    },
    "releaseState": {"$ref": "#/$defs/releaseState"},
    "ci": {"$ref": "#/$defs/ci"},
    "supplyChain": {"$ref": "#/$defs/supplyChain"},
    "closure": {"$ref": "#/$defs/closure"},
    "attestationDigest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "$defs": {
    "repositoryPath": {
      "type": "string",
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$))[^/\\\\]+(?:/[^/\\\\]+)*$"
    },
    "finalIssueState": {
      "type": "object",
      "required": ["schema", "version", "repository", "sourceSha", "ci", "issues"],
      "properties": {
        "schema": {"const": "fdir/github-issue-state"},
        "version": {"const": "1.0.0"},
        "repository": {"const": "horiyamayoh/fdir"},
        "sourceSha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "ci": {"$ref": "#/$defs/finalIssueCi"},
        "issues": {
          "type": "array",
          "minItems": 25,
          "maxItems": 25,
          "prefixItems": [
            {"allOf": [{"$ref": "#/$defs/finalIssueClosed"}, {"properties": {"issueNumber": {"const": 87}}}]},
            {"allOf": [{"$ref": "#/$defs/finalIssueClosed"}, {"properties": {"issueNumber": {"const": 88}}}]},
            {"allOf": [{"$ref": "#/$defs/finalIssueClosed"}, {"properties": {"issueNumber": {"const": 89}}}]},
            {"allOf": [{"$ref": "#/$defs/finalIssueClosed"}, {"properties": {"issueNumber": {"const": 90}}}]},
            {"allOf": [{"$ref": "#/$defs/finalIssueClosed"}, {"properties": {"issueNumber": {"const": 91}}}]},
            {"allOf": [{"$ref": "#/$defs/finalIssueClosed"}, {"properties": {"issueNumber": {"const": 92}}}]},
            {"allOf": [{"$ref": "#/$defs/finalIssueClosed"}, {"properties": {"issueNumber": {"const": 93}}}]},
            {"allOf": [{"$ref": "#/$defs/finalIssueClosed"}, {"properties": {"issueNumber": {"const": 94}}}]},
            {"allOf": [{"$ref": "#/$defs/finalIssueClosed"}, {"properties": {"issueNumber": {"const": 95}}}]},
            {"allOf": [{"$ref": "#/$defs/finalIssueClosed"}, {"properties": {"issueNumber": {"const": 96}}}]},
            {"allOf": [{"$ref": "#/$defs/finalIssueClosed"}, {"properties": {"issueNumber": {"const": 97}}}]},
            {"allOf": [{"$ref": "#/$defs/finalIssueClosed"}, {"properties": {"issueNumber": {"const": 98}}}]},
            {"allOf": [{"$ref": "#/$defs/finalIssueClosed"}, {"properties": {"issueNumber": {"const": 99}}}]},
            {"allOf": [{"$ref": "#/$defs/finalIssueClosed"}, {"properties": {"issueNumber": {"const": 100}}}]},
            {"allOf": [{"$ref": "#/$defs/finalIssueClosed"}, {"properties": {"issueNumber": {"const": 101}}}]},
            {"allOf": [{"$ref": "#/$defs/finalIssueClosed"}, {"properties": {"issueNumber": {"const": 102}}}]},
            {"allOf": [{"$ref": "#/$defs/finalIssueClosed"}, {"properties": {"issueNumber": {"const": 103}}}]},
            {"allOf": [{"$ref": "#/$defs/finalIssueClosed"}, {"properties": {"issueNumber": {"const": 104}}}]},
            {"allOf": [{"$ref": "#/$defs/finalIssueClosed"}, {"properties": {"issueNumber": {"const": 105}}}]},
            {"allOf": [{"$ref": "#/$defs/finalIssueClosed"}, {"properties": {"issueNumber": {"const": 108}}}]},
            {"allOf": [{"$ref": "#/$defs/finalIssueClosed"}, {"properties": {"issueNumber": {"const": 109}}}]},
            {"allOf": [{"$ref": "#/$defs/finalIssueClosed"}, {"properties": {"issueNumber": {"const": 110}}}]},
            {"allOf": [{"$ref": "#/$defs/finalIssueClosed"}, {"properties": {"issueNumber": {"const": 111}}}]},
            {"allOf": [{"$ref": "#/$defs/finalIssueClosed"}, {"properties": {"issueNumber": {"const": 112}}}]},
            {"allOf": [{"$ref": "#/$defs/finalIssueClosed"}, {"properties": {"issueNumber": {"const": 113}}}]}
          ],
          "items": {}
        }
      }
    },
    "finalIssueCi": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "repository", "sourceSha", "runId", "attempt", "job"],
      "properties": {
        "provider": {"const": "github-actions"},
        "repository": {"const": "horiyamayoh/fdir"},
        "sourceSha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "runId": {"type": "string", "pattern": "^[1-9][0-9]*$"},
        "attempt": {"type": "integer", "minimum": 1},
        "job": {"const": "qualification"}
      }
    },
    "finalIssueClosed": {
      "type": "object",
      "required": ["issueNumber", "state", "stateReason", "closedAt"],
      "properties": {
        "state": {"const": "closed"},
        "stateReason": {"const": "completed"},
        "closedAt": {"type": "string", "format": "date-time"}
      }
    },
    "integrityVerification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "method"],
      "properties": {
        "status": {"const": "verified"},
        "method": {"enum": ["independent-ci", "signature-verification", "provenance-verification"]}
      }
    },
    "retention": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expired", "expiresAt"],
      "properties": {
        "expired": {"const": false},
        "expiresAt": {"type": "string", "format": "date-time"}
      }
    },
    "candidateBundleBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "provider", "sourceSha", "runId", "attempt", "jobId", "artifactId", "artifactName", "artifactDigest", "artifactUrl", "retention", "manifestDigest", "manifestFileDigest", "verification", "selfAttested", "circular"],
      "properties": {
        "kind": {"const": "candidate-bundle"},
        "provider": {"const": "github-actions"},
        "sourceSha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "runId": {"type": "string", "pattern": "^[1-9][0-9]*$"},
        "attempt": {"type": "integer", "minimum": 1},
        "jobId": {"const": "qualification"},
        "artifactId": {"type": "string", "pattern": "^[1-9][0-9]*$"},
        "artifactName": {"type": "string", "pattern": "^fdir-qualification-bundle-[0-9a-f]{40}-attempt-[1-9][0-9]*$"},
        "artifactDigest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "artifactUrl": {"type": "string", "pattern": "^https://github\\.com/horiyamayoh/fdir/actions/runs/[1-9][0-9]*/artifacts/[1-9][0-9]*$"},
        "retention": {"$ref": "#/$defs/retention"},
        "manifestDigest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "manifestFileDigest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "verification": {
          "allOf": [
            {"$ref": "#/$defs/integrityVerification"},
            {"properties": {"method": {"const": "independent-ci"}}}
          ]
        },
        "selfAttested": {"const": false},
        "circular": {"const": false}
      }
    },
    "evidenceFileBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "provider", "sourceSha", "path", "sha256", "verification", "selfAttested", "circular"],
      "properties": {
        "kind": {"enum": ["package", "sbom", "dependency-lock", "signature", "provenance"]},
        "provider": {"const": "github-actions"},
        "sourceSha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "path": {
          "allOf": [
            {"$ref": "#/$defs/repositoryPath"},
            {"not": {"pattern": "(^|/)(?:release[_-]attestation(?:[-_.][A-Za-z0-9_-]+)*|release[_-]gate(?:[-_.][A-Za-z0-9_-]+)*|strict[_-]completion[_-]gate(?:[-_.][A-Za-z0-9_-]+)*)(?:\\.[A-Za-z0-9]+)?$"}}
          ]
        },
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "format": {"enum": ["cyclonedx-json", "spdx-json", "requirements-lock", "hashed-requirements", "sigstore-bundle", "dsse-envelope", "in-toto-statement", "slsa-provenance"]},
        "verification": {"$ref": "#/$defs/integrityVerification"},
        "selfAttested": {"const": false},
        "circular": {"const": false}
      }
    },
    "packageBinding": {
      "allOf": [
        {"$ref": "#/$defs/evidenceFileBinding"},
        {"properties": {"kind": {"const": "package"}, "verification": {"properties": {"method": {"const": "independent-ci"}}}}}
      ]
    },
    "sbomBinding": {
      "allOf": [
        {"$ref": "#/$defs/evidenceFileBinding"},
        {"required": ["format"], "properties": {"kind": {"const": "sbom"}, "format": {"enum": ["cyclonedx-json", "spdx-json"]}, "verification": {"properties": {"method": {"const": "independent-ci"}}}}}
      ]
    },
    "dependencyLockBinding": {
      "allOf": [
        {"$ref": "#/$defs/evidenceFileBinding"},
        {"required": ["format"], "properties": {"kind": {"const": "dependency-lock"}, "format": {"enum": ["requirements-lock", "hashed-requirements"]}, "verification": {"properties": {"method": {"const": "independent-ci"}}}}}
      ]
    },
    "signatureBinding": {
      "allOf": [
        {"$ref": "#/$defs/evidenceFileBinding"},
        {"required": ["format"], "properties": {"kind": {"const": "signature"}, "format": {"enum": ["sigstore-bundle", "dsse-envelope"]}, "verification": {"properties": {"method": {"const": "signature-verification"}}}}}
      ]
    },
    "supplyChainProvenanceBinding": {
      "allOf": [
        {"$ref": "#/$defs/evidenceFileBinding"},
        {"required": ["format"], "properties": {"kind": {"const": "provenance"}, "format": {"enum": ["in-toto-statement", "slsa-provenance"]}, "verification": {"properties": {"method": {"const": "provenance-verification"}}}}}
      ]
    },
    "supplyChain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidateBundle", "package", "sbom", "dependencyLock", "signature", "provenance"],
      "properties": {
        "candidateBundle": {"$ref": "#/$defs/candidateBundleBinding"},
        "package": {"$ref": "#/$defs/packageBinding"},
        "sbom": {"$ref": "#/$defs/sbomBinding"},
        "dependencyLock": {"$ref": "#/$defs/dependencyLockBinding"},
        "signature": {"$ref": "#/$defs/signatureBinding"},
        "provenance": {"$ref": "#/$defs/supplyChainProvenanceBinding"}
      }
    },
    "bundle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manifestPath", "manifestDigest", "manifestFileDigest", "sourceSha", "dirtyTree", "evidenceIds", "reports"],
      "properties": {
        "manifestPath": {"$ref": "#/$defs/repositoryPath"},
        "manifestDigest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "manifestFileDigest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "sourceSha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "dirtyTree": {"const": false},
        "evidenceIds": {"type": "array", "minItems": 18, "maxItems": 18, "uniqueItems": true, "items": {"type": "string", "pattern": "^issue-(?:88|89|90|91|92|93|94|95|96|97|98|99|100|101|102|103|104|105)-[A-Za-z0-9][A-Za-z0-9._-]*$"}},
        "reports": {"type": "array", "minItems": 18, "maxItems": 18, "items": {"$ref": "#/$defs/report"}}
      }
    },
    "report": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidenceId", "issueNumbers", "sourceSha", "generatedAt", "status", "sha256"],
      "properties": {
        "evidenceId": {"type": "string", "pattern": "^issue-(?:88|89|90|91|92|93|94|95|96|97|98|99|100|101|102|103|104|105)-[A-Za-z0-9][A-Za-z0-9._-]*$"},
        "issueNumbers": {"type": "array", "minItems": 1, "maxItems": 1, "uniqueItems": true, "items": {"type": "integer", "enum": [88, 89, 90, 91, 92, 93, 94, 95, 96, 97, 98, 99, 100, 101, 102, 103, 104, 105]}},
        "sourceSha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "generatedAt": {"type": "string", "format": "date-time"},
        "status": {"const": "passed"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "releaseState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "releaseBlocked", "blockingIssues", "openIssues", "snapshotDigest", "retrievedAt", "authority"],
      "properties": {
        "status": {"const": "release-ready"},
        "releaseBlocked": {"const": false},
        "blockingIssues": {"type": "array", "maxItems": 0},
        "openIssues": {"type": "array", "maxItems": 0},
        "snapshotDigest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "retrievedAt": {"type": "string", "format": "date-time"},
        "authority": {"const": "verified-snapshot"}
      }
    },
    "ci": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "repository", "sourceSha", "runId", "runUrl", "jobId", "attempt", "status", "conclusion", "artifact", "provenance"],
      "properties": {
        "provider": {"const": "github-actions"},
        "repository": {"const": "horiyamayoh/fdir"},
        "sourceSha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "runId": {"type": "string", "pattern": "^[1-9][0-9]*$"},
        "runUrl": {"type": "string", "pattern": "^https://github\\.com/horiyamayoh/fdir/actions/runs/[1-9][0-9]*$"},
        "jobId": {"const": "qualification"},
        "attempt": {"type": "integer", "minimum": 1},
        "status": {"const": "completed"},
        "conclusion": {"const": "success"},
        "artifact": {"$ref": "#/$defs/artifact"},
        "provenance": {"$ref": "#/$defs/provenance"}
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "id", "name", "digest", "sha256", "url", "sizeInBytes", "expired", "expiresAt", "producerJob", "producerStep", "workflowRun"],
      "properties": {
        "status": {"const": "uploaded"},
        "id": {"type": "string", "pattern": "^[1-9][0-9]*$"},
        "name": {"type": "string", "minLength": 1},
        "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "url": {"type": "string", "pattern": "^https://github\\.com/horiyamayoh/fdir/actions/runs/[1-9][0-9]*/artifacts/[1-9][0-9]*$"},
        "sizeInBytes": {"type": "integer", "minimum": 1},
        "expired": {"const": false},
        "expiresAt": {"type": "string", "format": "date-time"},
        "producerJob": {"const": "Qualification bundle"},
        "producerStep": {"enum": ["Upload qualification bundle", "Upload qualification upload receipt"]},
        "workflowRun": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "head_sha"],
          "properties": {
            "id": {"type": "string", "pattern": "^[1-9][0-9]*$"},
            "head_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
          }
        }
      },
      "allOf": [
        {
          "if": {
            "required": ["producerStep"],
            "properties": {"producerStep": {"const": "Upload qualification bundle"}}
          },
          "then": {
            "properties": {"name": {"pattern": "^fdir-qualification-bundle-[0-9a-f]{40}-attempt-[1-9][0-9]*$"}}
          }
        },
        {
          "if": {
            "required": ["producerStep"],
            "properties": {"producerStep": {"const": "Upload qualification upload receipt"}}
          },
          "then": {
            "properties": {"name": {"pattern": "^fdir-qualification-receipt-[0-9a-f]{40}-attempt-[1-9][0-9]*$"}}
          }
        }
      ]
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidenceSchema", "evidenceVersion", "repository", "sourceSha", "candidateReady", "status", "run", "job", "steps", "step", "artifact", "receiptArtifact", "uploadReceipt"],
      "properties": {
        "evidenceSchema": {"const": "fdir/github-actions-release-evidence"},
        "evidenceVersion": {"const": "1.0.0"},
        "repository": {"const": "horiyamayoh/fdir"},
        "sourceSha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "candidateReady": {"const": true},
        "status": {"const": "pending-attestation"},
        "run": {"$ref": "#/$defs/run"},
        "job": {"$ref": "#/$defs/job"},
        "steps": {"$ref": "#/$defs/qualificationSteps"},
        "step": {"$ref": "#/$defs/uploadBundleStep"},
        "artifact": {"$ref": "#/$defs/artifact"},
        "receiptArtifact": {"$ref": "#/$defs/artifact"},
        "uploadReceipt": {"$ref": "#/$defs/uploadReceipt"}
      }
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "attempt", "status", "conclusion", "headSha", "path", "url", "attemptUrl"],
      "properties": {
        "id": {"type": "string", "pattern": "^[1-9][0-9]*$"},
        "attempt": {"type": "integer", "minimum": 1},
        "status": {"const": "completed"},
        "conclusion": {"const": "success"},
        "headSha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "path": {"const": ".github/workflows/design.yml"},
        "url": {"type": "string", "pattern": "^https://github\\.com/horiyamayoh/fdir/actions/runs/[1-9][0-9]*$"},
        "attemptUrl": {"type": "string", "pattern": "^https://github\\.com/horiyamayoh/fdir/actions/runs/[1-9][0-9]*/attempts/[1-9][0-9]*$"}
      }
    },
    "job": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "profile", "runId", "attempt", "headSha", "status", "conclusion", "url", "steps"],
      "properties": {
        "id": {"type": "string", "pattern": "^[1-9][0-9]*$"},
        "name": {"const": "Qualification bundle"},
        "profile": {"const": "qualification"},
        "runId": {"type": "string", "pattern": "^[1-9][0-9]*$"},
        "attempt": {"type": "integer", "minimum": 1},
        "headSha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "status": {"const": "completed"},
        "conclusion": {"const": "success"},
        "url": {"type": "string", "pattern": "^https://github\\.com/horiyamayoh/fdir/actions/runs/[1-9][0-9]*/job/[1-9][0-9]*$"},
        "steps": {"$ref": "#/$defs/qualificationSteps"}
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["number", "name", "status", "conclusion", "url"],
      "properties": {
        "number": {"type": "integer", "minimum": 1},
        "name": {"type": "string", "minLength": 1},
        "status": {"const": "completed"},
        "conclusion": {"const": "success"},
        "url": {"type": "string", "pattern": "^https://github\\.com/horiyamayoh/fdir/actions/runs/[1-9][0-9]*/job/[1-9][0-9]*#step:[1-9][0-9]*$"}
      }
    },
    "uploadBundleStep": {
      "allOf": [
        {"$ref": "#/$defs/step"},
        {"required": ["name"], "properties": {"name": {"const": "Upload qualification bundle"}}}
      ]
    },
    "qualificationSteps": {
      "type": "array",
      "minItems": 16,
      "items": {"$ref": "#/$defs/step"},
      "allOf": [
        {"contains": {"required": ["name"], "properties": {"name": {"const": "Validate workflow identity"}}}, "minContains": 1},
        {"contains": {"required": ["name"], "properties": {"name": {"const": "Validate design authority"}}}, "minContains": 1},
        {"contains": {"required": ["name"], "properties": {"name": {"const": "Validate generated model contract"}}}, "minContains": 1},
        {"contains": {"required": ["name"], "properties": {"name": {"const": "Validate qualification contract"}}}, "minContains": 1},
        {"contains": {"required": ["name"], "properties": {"name": {"const": "Validate qualification schema"}}}, "minContains": 1},
        {"contains": {"required": ["name"], "properties": {"name": {"const": "Run Evidence integrity matrix"}}}, "minContains": 1},
        {"contains": {"required": ["name"], "properties": {"name": {"const": "Run clean-room replay"}}}, "minContains": 1},
        {"contains": {"required": ["name"], "properties": {"name": {"const": "Prepare commit-bound bundle path"}}}, "minContains": 1},
        {"contains": {"required": ["name"], "properties": {"name": {"const": "Build commit-bound qualification bundle"}}}, "minContains": 1},
        {"contains": {"required": ["name"], "properties": {"name": {"const": "Validate commit-bound qualification bundle"}}}, "minContains": 1},
        {"contains": {"required": ["name"], "properties": {"name": {"const": "Run candidate qualification gate"}}}, "minContains": 1},
        {"contains": {"required": ["name"], "properties": {"name": {"const": "Publish qualification digest"}}}, "minContains": 1},
        {"contains": {"required": ["name"], "properties": {"name": {"const": "Run real-input adapter E2E"}}}, "minContains": 1},
        {"contains": {"required": ["name"], "properties": {"name": {"const": "Upload qualification bundle"}}}, "minContains": 1},
        {"contains": {"required": ["name"], "properties": {"name": {"const": "Write qualification upload receipt"}}}, "minContains": 1},
        {"contains": {"required": ["name"], "properties": {"name": {"const": "Upload qualification upload receipt"}}}, "minContains": 1}
      ]
    },
    "uploadReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "version", "provider", "repository", "sourceSha", "runId", "attempt", "job", "artifact", "links", "receiptDigest"],
      "properties": {
        "schema": {"const": "fdir/qualification-upload-receipt"},
        "version": {"const": "1.0.0"},
        "provider": {"const": "github-actions"},
        "repository": {"const": "horiyamayoh/fdir"},
        "sourceSha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "runId": {"type": "string", "pattern": "^[1-9][0-9]*$"},
        "attempt": {"type": "integer", "minimum": 1},
        "job": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "name"],
          "properties": {
            "id": {"const": "qualification"},
            "name": {"const": "Qualification bundle"}
          }
        },
        "artifact": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "name", "id", "digest", "url"],
          "properties": {
            "status": {"const": "uploaded"},
            "name": {"type": "string", "pattern": "^fdir-qualification-bundle-[0-9a-f]{40}-attempt-[1-9][0-9]*$"},
            "id": {"type": "string", "pattern": "^[1-9][0-9]*$"},
            "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
            "url": {"type": "string", "pattern": "^https://github\\.com/horiyamayoh/fdir/actions/runs/[1-9][0-9]*/artifacts/[1-9][0-9]*$"}
          }
        },
        "links": {
          "type": "object",
          "additionalProperties": false,
          "required": ["source", "run", "attempt"],
          "properties": {
            "source": {"type": "string", "pattern": "^https://github\\.com/horiyamayoh/fdir/commit/[0-9a-f]{40}$"},
