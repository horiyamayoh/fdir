{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/horiyamayoh/fdir/schema/extensions/format-extensions/1.0.0",
  "type": "object",
  "$defs": {
    "docx-numbering": {"type":"object","additionalProperties":false,"properties":{"numId":{"type":"string"},"ilvl":{"type":"string"}},"required":["numId","ilvl"]},
    "docx-drawing": {"type":"object","additionalProperties":false,"properties":{"kind":{"type":"string","enum":["shape","textBox","connector","image","chart"]},"anchor":{"type":"string","enum":["inline","floating","page","paragraph"]},"extentEmu":{"type":"object","additionalProperties":false,"properties":{"cx":{"type":"string"},"cy":{"type":"string"}},"required":["cx","cy"]}},"required":["kind","anchor","extentEmu"]},
    "docx-connector-target": {"type":"object","additionalProperties":false,"properties":{"endpoint":{"type":"string","enum":["start","to"]},"sourceId":{"type":"string"}},"required":["endpoint","sourceId"]},
    "docx-revision": {"type":"object","additionalProperties":false,"properties":{"kind":{"type":"string","enum":["insert","delete","move"]},"author":{"type":"string"},"revisionId":{"type":"string"}},"required":["kind","author","revisionId"]},
    "docx-annotation-body": {"type":"object","additionalProperties":false,"properties":{"part":{"type":"string"},"id":{"type":"string"},"body":{"type":"string"}},"required":["part","id","body"]},
    "docx-drawingml-callout": {"type":"object","additionalProperties":false,"properties":{"presetGeometry":{"type":"string"}},"required":["presetGeometry"]},
    "xlsx-table-definition": {"type":"object","additionalProperties":false,"properties":{"path":{"type":"string"},"name":{"type":"string"},"range":{"type":"string"}},"required":["path","name","range"]},
    "xlsx-conditional-formatting": {"type":"object","additionalProperties":false,"properties":{"range":{"type":"string"},"rules":{"type":"array","items":{"type":"object","additionalProperties":false,"properties":{"type":{"type":"string"},"operator":{"type":"string"},"priority":{"type":"string"},"formula":{"type":"array","items":{"type":"string"}}},"required":["type","operator","priority","formula"]}}},"required":["range","rules"]},
    "xlsx-rich-text": {"type":"object","additionalProperties":false,"properties":{"runs":{"type":"array","items":{"type":"object","additionalProperties":false,"properties":{"text":{"type":"string"},"bold":{"type":"boolean"},"italic":{"type":"boolean"},"underline":{"type":"string"},"phonetic":{"type":"string"}},"required":["text"]}},"phonetic":{"type":"array","items":{"type":"string"}}},"required":["runs"]},
    "xlsx-view": {"type":"object","additionalProperties":false,"properties":{"viewId":{"type":"string"},"pane":{"type":"object","additionalProperties":false,"properties":{"xSplit":{"type":"string"},"ySplit":{"type":"string"},"topLeftCell":{"type":"string"},"activePane":{"type":"string"},"state":{"type":"string"}}},"selection":{"type":"array","items":{"type":"object","additionalProperties":false,"properties":{"pane":{"type":"string"},"activeCell":{"type":"string"},"sqref":{"type":"string"}},"required":["pane","activeCell","sqref"]}}},"required":["viewId","pane","selection"]},
    "xlsx-data-validation": {"type":"object","additionalProperties":false,"properties":{"range":{"type":"string"},"type":{"type":"string"},"operator":{"type":"string"},"allowBlank":{"type":"boolean"},"formulas":{"type":"array","items":{"type":"string"}}},"required":["range","type","operator","formulas"]},
    "xlsx-defined-name": {"type":"object","additionalProperties":false,"properties":{"name":{"type":"string"},"localSheetId":{"type":"string"},"hidden":{"type":"boolean"},"formula":{"type":"string"}},"required":["name","localSheetId","hidden","formula"]},
    "pdf-glyph-provenance": {"type":"object","additionalProperties":false,"properties":{"characterCode":{"type":"string"},"glyphName":{"type":"string"},"unicode":{"type":"string"},"mappingStatus":{"type":"string","enum":["preserved","approximated","unavailable"]}},"required":["characterCode","glyphName","unicode","mappingStatus"]},
    "pdf-font-cmap": {"type":"object","additionalProperties":false,"properties":{"fontObject":{"type":"string"},"mappingStatus":{"type":"string","enum":["preserved","unavailable"]},"mappings":{"type":"array","items":{"type":"object","additionalProperties":false,"properties":{"sourceCode":{"type":"string"},"unicode":{"type":"string"}},"required":["sourceCode","unicode"]}}},"required":["fontObject","mappingStatus","mappings"]},
    "pdf-graphics-state": {"type":"object","additionalProperties":false,"properties":{"page":{"type":"integer","minimum":1},"operator":{"type":"string","enum":["q","Q","cm","rg","RG","g","G","k","K","w","J","j","M","d","ri","gs","sh"]},"operands":{"type":"array","items":{"type":["string","array"]}},"state":{"type":"object","additionalProperties":false,"properties":{"ctm":{"type":"array","items":{"type":"string"},"minItems":6,"maxItems":6},"lineWidth":{"type":"string"},"lineCap":{"type":"integer","minimum":0,"maximum":2},"lineJoin":{"type":"integer","minimum":0,"maximum":2},"miterLimit":{"type":"string"},"dashPattern":{"type":"object","additionalProperties":false,"properties":{"array":{"type":"array","items":{"type":"string"}},"phase":{"type":"string"}},"required":["array","phase"]},"renderingIntent":{"type":["string","null"]},"extGState":{"type":["string","null"]},"shading":{"type":["string","null"]},"fillColor":{"type":"array","items":{"type":"string"}},"strokeColor":{"type":"array","items":{"type":"string"}}},"required":["ctm","lineWidth","lineCap","lineJoin","miterLimit","dashPattern","renderingIntent","extGState","shading","fillColor","strokeColor"]}},"required":["page","operator","operands","state"]},
    "markdown-authoring-facts": {"type":"object","additionalProperties":false,"properties":{"delimiter":{"type":"string"},"delimiters":{"type":"array","items":{"type":"string"}},"escaping":{"type":"array","items":{"type":"string"}},"lineBreak":{"type":"string","enum":["soft","hard"]},"referenceStyle":{"type":"string"},"rawHtml":{"type":"boolean"}},"required":["delimiter"]},
    "markdown-source": {"type":"object","additionalProperties":false,"properties":{"source":{"type":"string"}},"required":["source"]},
    "markdown-table-authoring": {"type":"object","additionalProperties":false,"properties":{"delimiter":{"type":"string"},"alignment":{"type":"array","items":{"type":"string"}}},"required":["delimiter","alignment"]},
    "markdown-unsupported-directive": {"type":"object","additionalProperties":false,"properties":{"opening":{"type":"string"},"body":{"type":"array","items":{"type":"string"}}},"required":["opening","body"]},
    "markdown-code-block": {"type":"object","additionalProperties":false,"properties":{"fence":{"type":"string"},"language":{"type":"string"},"content":{"type":"string"}},"required":["fence","language","content"]},
    "markdown-heading-authoring": {"type":"object","additionalProperties":false,"properties":{"level":{"type":"integer","minimum":1,"maximum":6},"marker":{"type":"string"}},"required":["level","marker"]},
    "markdown-reference-definition": {"type":"object","additionalProperties":false,"properties":{"label":{"type":"string"},"destination":{"type":"string"},"title":{"type":"string"}},"required":["label","destination","title"]},
    "markdown-list-marker": {"type":"object","additionalProperties":false,"properties":{"marker":{"type":"string"},"level":{"type":"integer","minimum":0}},"required":["marker","level"]},
    "markdown-blockquote": {"type":"object","additionalProperties":false,"properties":{"marker":{"type":"string","const":">"}},"required":["marker"]},
    "markdown-front-matter": {"type":"object","additionalProperties":false,"properties":{"entries":{"type":"array","items":{"type":"object","additionalProperties":false,"properties":{"key":{"type":"string"},"value":{"type":"string"}},"required":["key","value"]}}},"required":["entries"]}
  }
}
