{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/horiyamayoh/fdir/schemas/qualification-issue-104-report.schema.json",
  "title": "FDIR issue 104 qualification report",
  "type": "object",
  "required": [
    "schema",
    "version",
    "issueNumber",
    "reportKind",
    "sourceSha",
    "corpusSha256",
    "generatedAt",
    "status",
    "completionStatus",
    "implementedScope",
    "unmetRequirements",
    "assertions"
  ],
  "properties": {
    "schema": {"const": "fdir/qualification-issue-104-report"},
    "version": {"const": "1.0.0"},
    "issueNumber": {"const": 104},
    "reportKind": {"enum": ["corpus-provenance-independence", "requirement-corpus-coverage", "multi-producer-results", "differential-adjudication", "metamorphic-relations", "hostile-resource-boundaries", "fixture-oracle-digest-manifest"]},
    "sourceSha": {"anyOf": [{"type": "null"}, {"type": "string", "pattern": "^[0-9a-f]{40}$"}]},
    "corpusSha256": {"anyOf": [{"type": "null"}, {"type": "string", "pattern": "^[0-9a-f]{64}$"}]},
    "generatedAt": {"type": "string", "format": "date-time"},
    "status": {"enum": ["passed", "failed"]},
    "completionStatus": {"enum": ["qualified", "incomplete-strict-gate"]},
    "implementedScope": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "unmetRequirements": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "sectionStatus": {"enum": ["passed", "failed"]},
    "assertions": {"type": "array", "items": {"type": "object", "required": ["id", "status"], "properties": {"id": {"type": "string", "minLength": 1}, "status": {"enum": ["passed", "failed", "not-required"]}}}},
    "failure": {"type": "object", "required": ["code", "message"], "properties": {"code": {"type": "string", "minLength": 1}, "message": {"type": "string", "minLength": 1}}}
  },
  "additionalProperties": true
}
