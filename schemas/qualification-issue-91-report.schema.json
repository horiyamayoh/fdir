{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/horiyamayoh/fdir/schemas/qualification-issue-91-report.schema.json/1.0.0",
  "title": "FDIR issue 91 aggregate qualification report",
  "description": "Aggregate source-occurrence evidence for issue 91. The report is commit-bound by Git HEAD and qualifies independently enumerated occurrences against the public adapter output.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "issueNumber",
    "reportKind",
    "status",
    "conversionStatus",
    "sourceSha",
    "sourceShaKind",
    "caseSourceDigest",
    "caseSourceDigestKind",
    "caseCount",
    "caseIds",
    "formats",
    "sourceOccurrenceCount",
    "caseSummaries",
    "adapterIrProvided",
    "accountingInputProvided",
    "blockers"
  ],
  "properties": {
    "schema": {
      "const": "fdir/qualification-issue-91-aggregate-report"
    },
    "version": {
      "const": "1.0.0"
    },
    "issueNumber": {
      "const": 91
    },
    "reportKind": {
      "enum": [
        "source-occurrence-accounting",
        "capability-profile-coverage",
        "status-aggregation",
        "unaccounted-occurrences"
      ]
    },
    "status": {
      "enum": ["passed", "failed"]
    },
    "conversionStatus": {
      "enum": ["qualified", "failed"]
    },
    "sourceSha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "sourceShaKind": {
      "const": "git-head"
    },
    "caseSourceDigest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "caseSourceDigestKind": {
      "const": "sha256(canonical-case-source-digest-manifest)"
    },
    "caseCount": {
      "type": "integer",
      "minimum": 1
    },
    "caseIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
      }
    },
    "formats": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "uniqueItems": true,
      "allOf": [
        {"contains": {"const": "docx"}},
        {"contains": {"const": "xlsx"}},
        {"contains": {"const": "pdf"}},
        {"contains": {"const": "markdown"}}
      ],
      "items": {
        "enum": ["docx", "xlsx", "pdf", "markdown"]
      }
    },
    "sourceOccurrenceCount": {
      "type": "integer",
      "minimum": 1
    },
    "caseSummaries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/caseSummary"
      }
    },
    "adapterIrProvided": {
      "const": true
    },
    "accountingInputProvided": {
      "const": true
    },
    "blockers": {
      "type": "array",
      "minItems": 0,
      "items": {
        "$ref": "#/$defs/blocker"
      }
    },
    "sourceOccurrences": {
      "type": "array"
    },
    "accounting": {
      "type": "object"
    },
    "laneFailures": {
      "type": "array"
    },
    "failures": {
      "type": "array"
    },
    "assertions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/assertion"
      }
    },
    "profileCoverage": {
      "type": "array"
    },
    "profileBound": {
      "type": "boolean"
    },
    "unknownConstructs": {
      "type": "array"
    },
    "coverageBlockers": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/blocker"
      }
    },
    "completeAllowed": {
      "type": "boolean"
    },
    "aggregateStatus": {
      "enum": ["passed", "failed"]
    },
    "unaccountedOccurrenceCount": {
      "type": "integer",
      "minimum": 0
    },
    "targetBindingCount": {
      "type": "integer",
      "minimum": 0
    },
    "diagnosticBindingCount": {
      "type": "integer",
      "minimum": 0
    },
    "failureCount": {
      "type": "integer",
      "minimum": 0
    },
    "caseStatuses": {
      "type": "array"
    },
    "unaccountedOccurrenceIds": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "unaccountedSourceOccurrenceCount": {
      "type": "integer",
      "minimum": 0
    },
    "duplicateSourceOccurrenceIds": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "bindingBlockers": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/blocker"
      }
    }
  },
  "oneOf": [
    {
      "properties": {
        "reportKind": {"const": "source-occurrence-accounting"}
      },
      "required": ["sourceOccurrences", "accounting", "laneFailures", "failures", "assertions"]
    },
    {
      "properties": {
        "reportKind": {"const": "capability-profile-coverage"}
      },
      "required": ["profileCoverage", "profileBound", "unknownConstructs", "coverageBlockers", "assertions"]
    },
    {
      "properties": {
        "reportKind": {"const": "status-aggregation"}
      },
      "required": ["completeAllowed", "aggregateStatus", "unaccountedOccurrenceCount", "targetBindingCount", "diagnosticBindingCount", "failureCount", "caseStatuses", "assertions"]
    },
    {
      "properties": {
        "reportKind": {"const": "unaccounted-occurrences"}
      },
      "required": ["unaccountedOccurrenceIds", "unaccountedSourceOccurrenceCount", "duplicateSourceOccurrenceIds", "unknownConstructs", "bindingBlockers", "assertions"]
    }
  ],
  "$defs": {
    "caseSummary": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "caseId",
        "format",
        "relativePath",
        "caseSourceSha",
        "sourceOccurrenceCount",
        "targetBindingCount",
        "diagnosticBindingCount"
      ],
      "properties": {
        "caseId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "format": {
          "enum": ["docx", "xlsx", "pdf", "markdown"]
        },
        "relativePath": {
          "type": "string",
          "minLength": 1
        },
        "caseSourceSha": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "sourceOccurrenceCount": {
          "type": "integer",
          "minimum": 1
        },
        "targetBindingCount": {
          "type": "integer",
          "minimum": 0
        },
        "diagnosticBindingCount": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "blocker": {
      "type": "object",
      "additionalProperties": true,
      "required": ["code", "message", "severity"],
      "properties": {
        "code": {"type": "string", "minLength": 1},
        "message": {"type": "string", "minLength": 1},
        "severity": {"const": "blocker"}
      }
    },
    "assertion": {
      "type": "object",
      "additionalProperties": true,
      "required": ["assertionId", "expected", "actual", "status"],
      "properties": {
        "assertionId": {"type": "string", "minLength": 1},
        "expected": {},
        "actual": {},
        "status": {"enum": ["passed", "failed"]}
      }
    }
  }
}
