{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/horiyamayoh/fdir/schemas/qualification-issue-104-corpus.schema.json",
  "title": "FDIR issue 104 independent multi-producer and hostile corpus",
  "type": "object",
  "required": [
    "schema",
    "version",
    "issueNumber",
    "qualificationScope",
    "reportNames",
    "oracle",
    "gradePolicy",
    "fixtures",
    "producerMatrix",
    "adjudicationGroups",
    "metamorphicRelations",
    "hostileCases",
    "requirements",
    "legacyManifestAudit",
    "officialCorpusPolicy"
  ],
  "properties": {
    "schema": {"const": "fdir/qualification-issue-104-corpus"},
    "version": {"const": "1.0.0"},
    "issueNumber": {"const": 104},
    "qualificationScope": {"const": "independent-multi-producer-hostile-corpus"},
    "reportNames": {
      "type": "array",
      "const": [
        "corpus-provenance-independence.json",
        "requirement-corpus-coverage.json",
        "multi-producer-results.json",
        "differential-adjudication.json",
        "metamorphic-relations.json",
        "hostile-resource-boundaries.json",
        "fixture-oracle-digest-manifest.json"
      ]
    },
    "oracle": {
      "type": "object",
      "required": [
        "expectedValuesAreRuntimeIndependent",
        "expectedFactsAreAuthored",
        "adapterOutputUsedForExpected",
        "adapterOutputUsedToCreateCorpus",
        "sourceReader",
        "forbiddenDerivations"
      ],
      "properties": {
        "expectedValuesAreRuntimeIndependent": {"const": true},
        "expectedFactsAreAuthored": {"const": true},
        "adapterOutputUsedForExpected": {"const": false},
        "adapterOutputUsedToCreateCorpus": {"const": false},
        "sourceReader": {"type": "string", "minLength": 1},
        "forbiddenDerivations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    },
    "gradePolicy": {
      "type": "object",
      "required": [
        "scale",
        "minimumPassingGrade",
        "requiredPassingGrades",
        "gradeDIsNonQualifying",
        "requireAtLeastOneAvailableNonD",
        "requiredOfficialArtifactsCannotBeReplacedByGradeD"
      ],
      "properties": {
        "scale": {"type": "object", "required": ["A", "B", "C", "D", "unavailable"], "additionalProperties": {"type": "string", "minLength": 1}},
        "minimumPassingGrade": {"const": "C"},
        "requiredPassingGrades": {"const": ["A", "B", "C"]},
        "gradeDIsNonQualifying": {"const": true},
        "requireAtLeastOneAvailableNonD": {"const": true},
        "requiredOfficialArtifactsCannotBeReplacedByGradeD": {"const": true}
      }
    },
    "fixtures": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/fixture"
      }
    },
    "producerMatrix": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/producer"}
    },
    "adjudicationGroups": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["groupId", "format", "producerIds", "required", "factIds"],
        "properties": {
          "groupId": {"type": "string", "minLength": 1},
          "format": {"$ref": "#/$defs/format"},
          "producerIds": {"type": "array", "minItems": 2, "items": {"type": "string", "minLength": 1}},
          "required": {"const": true},
          "factIds": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
        }
      }
    },
    "metamorphicRelations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["relationId", "fixtureId", "transform", "preservesFactIds", "required"],
        "properties": {
          "relationId": {"type": "string", "minLength": 1},
          "fixtureId": {"type": "string", "minLength": 1},
          "transform": {"type": "object", "required": ["type"], "properties": {"type": {"type": "string", "minLength": 1}}},
          "preservesFactIds": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "required": {"const": true}
        }
      }
    },
    "hostileCases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["caseId", "fixtureId", "mutation", "limits", "expected", "required"],
        "properties": {
          "caseId": {"type": "string", "minLength": 1},
          "fixtureId": {"type": "string", "minLength": 1},
          "mutation": {"type": "object", "required": ["type"], "properties": {"type": {"type": "string", "minLength": 1}}},
          "limits": {"type": "object", "additionalProperties": {"type": ["integer", "number"]}},
          "expected": {"type": "object", "required": ["conversionStatus"], "properties": {"conversionStatus": {"const": "failed"}, "diagnosticContains": {"type": "string"}, "limitRejectedBeforeParse": {"type": "boolean"}}},
          "required": {"const": true}
        }
      }
    },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "object", "required": ["requirementId", "kind", "required"], "properties": {"requirementId": {"type": "string", "pattern": "^QUAL-104-"}, "kind": {"type": "string", "minLength": 1}, "required": {"const": true}}}
    },
    "legacyManifestAudit": {
      "type": "object",
      "required": ["manifestPath", "expectedIndependenceGrade", "nonQualifyingReasons"],
      "properties": {
        "manifestPath": {"type": "string", "minLength": 1},
        "expectedIndependenceGrade": {"const": "D"},
        "nonQualifyingReasons": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    },
    "officialCorpusPolicy": {
      "type": "object",
      "required": ["requiredAtQualificationTime", "missingArtifactIsUnmet", "gradeDSubstitutionForbidden", "artifactRoot", "runtimeFetchDefault", "runtimeFetchCanBeEnabled"],
      "properties": {
        "requiredAtQualificationTime": {"const": true},
        "missingArtifactIsUnmet": {"const": true},
        "gradeDSubstitutionForbidden": {"const": true},
        "artifactRoot": {"type": "string", "minLength": 1},
        "runtimeFetchDefault": {"const": false},
        "runtimeFetchCanBeEnabled": {"const": true}
      }
    }
  },
  "$defs": {
    "format": {"enum": ["docx", "xlsx", "pdf", "markdown"]},
    "digest": {
      "type": "object",
      "required": ["algorithm", "mode"],
      "properties": {
        "algorithm": {"const": "sha256"},
        "mode": {"enum": ["file", "member-manifest"]},
        "bytes": {"type": "integer", "minimum": 0},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "members": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["path", "bytes", "sha256"], "properties": {"path": {"type": "string", "minLength": 1}, "bytes": {"type": "integer", "minimum": 0}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}}
      },
      "allOf": [
        {"if": {"properties": {"mode": {"const": "file"}}}, "then": {"required": ["bytes", "sha256"]}},
        {"if": {"properties": {"mode": {"const": "member-manifest"}}}, "then": {"required": ["members"]}}
      ]
    },
    "fact": {
      "type": "object",
      "required": ["factId", "kind", "value", "sourceContains"],
      "properties": {
        "factId": {"type": "string", "minLength": 1},
        "kind": {"const": "literal"},
        "value": {"type": ["string", "number", "boolean"]},
        "sourceMember": {"type": "string", "minLength": 1},
        "sourceContains": {"const": true},
        "outputContains": {"type": "boolean"}
      }
    },
    "fixture": {
      "type": "object",
      "required": ["fixtureId", "scenarioId", "format", "producerId", "independenceGrade", "source", "provenance", "sourceDigest", "expectedFacts", "oracleDigest"],
      "properties": {
        "fixtureId": {"type": "string", "minLength": 1},
        "scenarioId": {"type": "string", "minLength": 1},
        "format": {"$ref": "#/$defs/format"},
        "producerId": {"type": "string", "minLength": 1},
        "independenceGrade": {"enum": ["A", "B", "C"]},
        "source": {"type": "object", "required": ["type", "path"], "properties": {"type": {"enum": ["repository-file", "repository-directory"]}, "path": {"type": "string", "minLength": 1}}},
        "provenance": {"type": "object", "required": ["origin", "sourceReference", "acquisitionMethod", "available"], "properties": {"origin": {"type": "string", "minLength": 1}, "sourceReference": {"type": "string", "minLength": 1}, "acquisitionMethod": {"type": "string", "minLength": 1}, "available": {"const": true}, "producerClaim": {"type": "string"}}},
        "sourceDigest": {"$ref": "#/$defs/digest"},
        "expectedFacts": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/fact"}},
        "oracleDigest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "producer": {
      "type": "object",
      "required": ["producerId", "format", "required", "availability", "provenance"],
      "properties": {
        "producerId": {"type": "string", "minLength": 1},
        "format": {"$ref": "#/$defs/format"},
        "required": {"type": "boolean"},
        "availability": {"enum": ["available", "missing"]},
        "fixtureId": {"type": "string", "minLength": 1},
        "independenceGrade": {"enum": ["A", "B", "C"]},
        "targetGrade": {"enum": ["A", "B", "C"]},
        "provenance": {"type": "object", "required": ["kind", "sourceReference"], "properties": {"kind": {"type": "string", "minLength": 1}, "sourceReference": {"type": "string", "minLength": 1}, "artifactPath": {"type": "string", "minLength": 1}}},
        "missingReason": {"type": "string", "minLength": 1}
      }
    }
  }
}
