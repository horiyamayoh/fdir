      "caseClass": "positive",
      "expectedStatus": "partial"
    },
    {
      "id": "markdown-independent",
      "format": "markdown",
      "kind": "file",
      "path": "markdown-independent.md",
      "expected": ["Independent Markdown", "escaped | pipe"],
      "caseClass": "positive",
      "expectedStatus": "partial"
    }
