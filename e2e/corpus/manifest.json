      "caseClass": "positive",
      "expectedStatus": "partial"
    },
    {
      "id": "docx-story-independent",
      "format": "docx",
      "kind": "ooxml-parts",
      "path": "docx-story-independent",
      "expected": ["Story Header"],
      "caseClass": "positive",
      "expectedStatus": "complete"
    },
    {
      "id": "xlsx-independent",
      "format": "xlsx",
      "kind": "ooxml-parts",
      "path": "xlsx-independent",
      "expected": ["Independent XLSX", "SUM(A1:A2)"],
      "caseClass": "positive",
      "expectedStatus": "complete-with-warnings"
    },
    {
      "id": "pdf-independent",
      "format": "pdf",
      "kind": "file",
      "path": "pdf-independent.pdf",
      "expected": ["Independent PDF"],
      "caseClass": "positive",
      "expectedStatus": "partial"
