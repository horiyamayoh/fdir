{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:fdir:adapter-worker-manifest:1",
  "title": "FDIR adapter worker manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "name",
    "version",
    "buildDigest",
    "implementationLanguage",
    "protocolVersions",
    "lanes",
    "capabilities",
    "dependencies",
    "normalizations",
    "unavailableSourceDistinctions",
    "unsafeCode",
    "ffi",
    "nativeCode",
    "receivesUntrustedDocumentBytes",
    "processBoundary",
    "networkPolicy",
    "qualificationState",
    "deterministic",
    "ownerIssue"
  ],
  "properties": {
    "schema": {
      "const": "fdir/adapter-worker-manifest/1"
    },
    "id": {
      "$ref": "#/$defs/id"
    },
    "name": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "version": {
      "$ref": "#/$defs/exactVersion"
    },
    "buildDigest": {
      "$ref": "#/$defs/digest"
    },
    "implementationLanguage": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "protocolVersions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "contains": {
        "const": "1.0.0"
      },
      "items": {
        "$ref": "#/$defs/exactVersion"
      }
    },
    "lanes": {
      "$ref": "#/$defs/lanes"
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/capability"
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/dependency"
      }
    },
    "normalizations": {
      "$ref": "#/$defs/stringArray"
    },
    "unavailableSourceDistinctions": {
      "$ref": "#/$defs/stringArray"
    },
    "unsafeCode": {
      "type": "boolean"
    },
    "ffi": {
      "type": "boolean"
    },
    "nativeCode": {
      "type": "boolean"
    },
    "receivesUntrustedDocumentBytes": {
      "type": "boolean"
    },
    "processBoundary": {
      "$ref": "#/$defs/processBoundary"
    },
    "networkPolicy": {
      "enum": [
        "deny",
        "allowlisted",
        "required"
      ]
    },
    "qualificationState": {
      "$ref": "#/$defs/qualificationState"
    },
    "deterministic": {
      "type": "boolean"
    },
    "ownerIssue": {
      "type": "integer",
      "minimum": 1
    }
  },
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\u0000-\\u001f]+$"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "exactVersion": {
      "type": "string",
      "minLength": 1,
      "not": {
        "pattern": "(?:[\\s*^~<>|]|(?:^|[.-])x$|^(?:latest|main|master|head|stable|nightly)$)"
      }
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "lane": {
      "enum": [
        "native-substrate-census",
        "semantic-helper",
        "renderer-observation",
        "ocr-inference-observation",
        "storage-codec"
      ]
    },
    "lanes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/lane"
      }
    },
    "stringArray": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/nonEmptyString"
      }
    },
    "processBoundary": {
      "enum": [
        "trusted-core",
        "in-process",
        "isolated-worker",
        "external-service-forbidden"
      ]
    },
    "qualificationState": {
      "enum": [
        "candidate",
        "admitted-unqualified",
        "adapter-qualified",
        "production-qualified",
        "rejected"
      ]
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "profiles",
        "lanes",
        "qualificationState"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "profiles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          }
        },
        "lanes": {
          "$ref": "#/$defs/lanes"
        },
        "qualificationState": {
          "$ref": "#/$defs/qualificationState"
        }
      }
    },
    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "features",
        "lanes",
        "normalizations",
        "unavailableSourceDistinctions",
        "unsafeCode",
        "ffi",
        "nativeCode",
        "processBoundary"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "version": {
          "$ref": "#/$defs/exactVersion"
        },
        "features": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          }
        },
        "lanes": {
          "$ref": "#/$defs/lanes"
        },
        "normalizations": {
          "$ref": "#/$defs/stringArray"
        },
        "unavailableSourceDistinctions": {
          "$ref": "#/$defs/stringArray"
        },
        "unsafeCode": {
          "type": "boolean"
        },
        "ffi": {
          "type": "boolean"
        },
        "nativeCode": {
          "type": "boolean"
        },
        "processBoundary": {
          "$ref": "#/$defs/processBoundary"
        }
      }
    }
  }
}
