    {"evidenceId":"issue-98-canonical-identity","issueNumbers":[98],"requirementIds":["QUAL-98-CANONICAL-IDENTITY"],"command":["python","tools/defect_profile_canonical.py","--probe","canonical-key-order"],"inputs":[{"path":"machine/canonicalization.json","role":"canonicalization-contract"},{"path":"tools/canonicalize_ir.py","role":"canonicalizer"},{"path":"tools/defect_profile_canonical.py","role":"canonical-probe"}],"outputs":[{"sourcePath":"machine/canonicalization.json","path":"artifacts/98/canonicalization.json","role":"canonicalization-contract"},{"sourcePath":"tools/canonicalize_ir.py","path":"artifacts/98/canonicalize_ir.py","role":"canonicalizer"}]},
