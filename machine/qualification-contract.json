{
  "schema": "fdir/qualification-contract",
  "version": "1.0.0",
  "repository": "horiyamayoh/fdir",
  "evidenceSchema": "schemas/qualification-evidence.schema.json",
  "scope": {
    "issueNumbers": [88, 89, 90, 91, 92, 93, 94, 95, 96, 97, 98, 99, 100, 101, 102, 103, 104, 105],
    "requiredEvidenceIds": [
      "issue-88-qualification-contract", "issue-89-defect-injection", "issue-90-model-contract",
      "issue-91-occurrence-accounting", "issue-92-exact-values", "issue-93-style-provenance",
      "issue-94-geometry-order", "issue-95-topology", "issue-96-relationship-closure",
      "issue-97-extension-registry", "issue-98-canonical-identity", "issue-99-docx-profile",
      "issue-100-xlsx-profile", "issue-101-pdf-profile", "issue-102-markdown-profile",
      "issue-103-query-index", "issue-104-independent-corpus", "issue-105-release-quality"
    ],
    "requiredRequirementIds": [
      "QUAL-88-EVIDENCE-OBJECT", "QUAL-89-MUST-MUTATIONS", "QUAL-90-AUTHORITY-CLOSURE",
      "QUAL-91-OCCURRENCE-ACCOUNTING", "QUAL-92-EXACT-LANES", "QUAL-93-STYLE-PROVENANCE",
      "QUAL-94-GEOMETRY-ORDER", "QUAL-95-TOPOLOGY", "QUAL-96-RELATIONSHIP-CLOSURE",
      "QUAL-97-EXTENSION-CLOSURE", "QUAL-98-CANONICAL-IDENTITY", "QUAL-99-DOCX-PROFILE",
      "QUAL-100-XLSX-PROFILE", "QUAL-101-PDF-PROFILE", "QUAL-102-MARKDOWN-PROFILE",
      "QUAL-103-QUERY-INDEX", "QUAL-104-INDEPENDENT-CORPUS", "QUAL-105-RELEASE-BARRIER"
    ]
  },
  "sourcePolicy": {
    "shaFormat": "git-40-lowercase-hex",
    "mustMatchHead": true,
    "releaseEvidenceMustBeClean": true
  },
  "bundlePolicy": {
    "manifestName": "manifest.json",
    "manifestDigest": "sha256(canonical-json(manifest-with-manifestDigest-omitted))",
    "payloadDigestAlgorithm": "sha256",
    "payloadFiles": "all regular files below bundle root except manifest.json",
    "dirtyTree": "git status of the repository excluding the generated bundle directory",
    "inputPaths": "repository-relative POSIX paths",
    "outputPaths": "bundle-relative POSIX paths",
    "issueIndexPattern": "issues/<issue-number>.json",
    "reportPattern": "reports/<evidence-id>.json",
    "logPattern": "logs/<evidence-id>.(stdout|stderr).txt"
  },
  "environmentPolicy": {
    "requiredFields": ["os", "architecture", "python", "runtime", "dependencyLockDigest"],
    "dependencyLockFiles": [],
    "dependencyLockBasis": "fdir-stdlib-only-dependencies-v1"
  },
  "ciPolicy": {
    "allowedProviders": ["github-actions", "local"],
    "releaseStatus": "completed",
    "githubActionsRunUrlPattern": "https://github.com/<repository>/actions/runs/<run-id>",
    "localRunUrlPrefix": "local://"
  },
  "defaultEvidence": [
    {"evidenceId":"issue-88-qualification-contract","issueNumbers":[88],"requirementIds":["QUAL-88-EVIDENCE-OBJECT"],"command":["python","tools/validate_qualification_bundle.py","--schema-only"],"inputs":[{"path":"machine/qualification-contract.json","role":"qualification-contract"},{"path":"schemas/qualification-evidence.schema.json","role":"evidence-schema"},{"path":"machine/strict-completion-contract.json","role":"strict-completion-policy"}],"outputs":[{"sourcePath":"machine/qualification-contract.json","path":"artifacts/88/qualification-contract.json","role":"contract-snapshot"},{"sourcePath":"schemas/qualification-evidence.schema.json","path":"artifacts/88/qualification-evidence.schema.json","role":"schema-snapshot"},{"sourcePath":"machine/strict-completion-contract.json","path":"artifacts/88/strict-completion-contract.json","role":"strict-policy-snapshot"}]},
    {"evidenceId":"issue-89-defect-injection","issueNumbers":[89],"requirementIds":["QUAL-89-MUST-MUTATIONS"],"command":["python","tools/run_defect_injection_campaign.py","--jobs","8","--allow-dirty-base","--out","e2e/.run/qualification-issue-89.json","--artifact-dir","e2e/.run/qualification-issue-89-artifacts"],"inputs":[{"path":"machine/defect-injection-contract.json","role":"defect-contract"},{"path":"tools/run_defect_injection_campaign.py","role":"campaign-runner"},{"path":"tools/defect_profile_formats.py","role":"format-probes"}],"outputs":[{"sourcePath":"e2e/.run/qualification-issue-89.json","path":"artifacts/89/defect-injection-campaign.json","role":"campaign-report"},{"sourcePath":"machine/defect-injection-contract.json","path":"artifacts/89/defect-injection-contract.json","role":"campaign-contract"},{"sourceDirectory":"e2e/.run/qualification-issue-89-artifacts","path":"artifacts/89/defect-injection-artifacts","role":"campaign-artifacts"}]},
    {"evidenceId":"issue-90-model-contract","issueNumbers":[90],"requirementIds":["QUAL-90-AUTHORITY-CLOSURE"],"command":["python","tools/validate_model_contract.py","--check"],"inputs":[{"path":"machine/model-contract.json","role":"normative-model"},{"path":"machine/reference-registry.json","role":"reference-registry"},{"path":"schemas/document-form-ir.schema.json","role":"generated-schema"}],"outputs":[{"sourcePath":"machine/model-contract.json","path":"artifacts/90/model-contract.json","role":"model-contract"},{"sourcePath":"machine/reference-registry.json","path":"artifacts/90/reference-registry.json","role":"reference-registry"},{"sourcePath":"schemas/document-form-ir.schema.json","path":"artifacts/90/document-form-ir.schema.json","role":"generated-schema"}]},
    {"evidenceId":"issue-91-occurrence-accounting","issueNumbers":[91],"requirementIds":["QUAL-91-OCCURRENCE-ACCOUNTING"],"command":["python","tools/run_acceptance.py","--all"],"inputs":[{"path":"tools/adapter_common.py","role":"status-accounting"},{"path":"tools/ir_validation.py","role":"runtime-validation"},{"path":"machine/capability-profile.json","role":"capability-policy"}],"outputs":[{"sourcePath":"tools/adapter_common.py","path":"artifacts/91/adapter_common.py","role":"status-accounting-source"},{"sourcePath":"machine/capability-profile.json","path":"artifacts/91/capability-profile.json","role":"capability-policy"}]},
    {"evidenceId":"issue-92-exact-values","issueNumbers":[92],"requirementIds":["QUAL-92-EXACT-LANES"],"command":["python","tools/run_e2e.py","--all","--json"],"inputs":[{"path":"tools/adapter_common.py","role":"value-lanes"},{"path":"tools/adapter_xlsx.py","role":"spreadsheet-lanes"},{"path":"tools/adapter_pdf.py","role":"glyph-lanes"}],"outputs":[{"sourcePath":"tools/adapter_xlsx.py","path":"artifacts/92/adapter_xlsx.py","role":"spreadsheet-adapter"},{"sourcePath":"tools/adapter_pdf.py","path":"artifacts/92/adapter_pdf.py","role":"pdf-glyph-adapter"}]},
    {"evidenceId":"issue-93-style-provenance","issueNumbers":[93],"requirementIds":["QUAL-93-STYLE-PROVENANCE"],"command":["python","tools/run_e2e.py","--all","--json"],"inputs":[{"path":"tools/adapter_docx.py","role":"docx-style-cascade"},{"path":"tools/adapter_xlsx.py","role":"xlsx-style-cascade"},{"path":"examples/style-resolution.json","role":"style-oracle-example"}],"outputs":[{"sourcePath":"tools/adapter_docx.py","path":"artifacts/93/adapter_docx.py","role":"docx-style-adapter"},{"sourcePath":"examples/style-resolution.json","path":"artifacts/93/style-resolution.json","role":"style-example"}]},
    {"evidenceId":"issue-94-geometry-order","issueNumbers":[94],"requirementIds":["QUAL-94-GEOMETRY-ORDER"],"command":["python","tools/run_e2e.py","--all","--json"],"inputs":[{"path":"tools/adapter_docx.py","role":"drawing-geometry"},{"path":"tools/adapter_pdf.py","role":"pdf-geometry-order"}],"outputs":[{"sourcePath":"tools/adapter_docx.py","path":"artifacts/94/adapter_docx.py","role":"docx-geometry-adapter"},{"sourcePath":"tools/adapter_pdf.py","path":"artifacts/94/adapter_pdf.py","role":"pdf-geometry-adapter"}]},
    {"evidenceId":"issue-95-topology","issueNumbers":[95],"requirementIds":["QUAL-95-TOPOLOGY"],"command":["python","tools/run_e2e.py","--all","--json"],"inputs":[{"path":"tools/adapter_docx.py","role":"docx-topology"},{"path":"tools/adapter_xlsx.py","role":"xlsx-topology"},{"path":"tools/adapter_markdown.py","role":"markdown-topology"}],"outputs":[{"sourcePath":"tools/adapter_docx.py","path":"artifacts/95/adapter_docx.py","role":"docx-topology-adapter"},{"sourcePath":"tools/adapter_xlsx.py","path":"artifacts/95/adapter_xlsx.py","role":"xlsx-topology-adapter"},{"sourcePath":"tools/adapter_markdown.py","path":"artifacts/95/adapter_markdown.py","role":"markdown-topology-adapter"}]},
    {"evidenceId":"issue-96-relationship-closure","issueNumbers":[96],"requirementIds":["QUAL-96-RELATIONSHIP-CLOSURE"],"command":["python","tools/run_e2e.py","--all","--json"],"inputs":[{"path":"machine/reference-registry.json","role":"relationship-registry"},{"path":"tools/adapter_docx.py","role":"docx-relationships"},{"path":"tools/adapter_xlsx.py","role":"xlsx-relationships"},{"path":"tools/adapter_pdf.py","role":"pdf-annotations"}],"outputs":[{"sourcePath":"machine/reference-registry.json","path":"artifacts/96/reference-registry.json","role":"relationship-registry"},{"sourcePath":"tools/adapter_docx.py","path":"artifacts/96/adapter_docx.py","role":"docx-relationship-adapter"}]},
