    {"evidenceId":"issue-100-xlsx-profile","issueNumbers":[100],"requirementIds":["QUAL-100-XLSX-PROFILE"],"command":["python","tools/run_e2e.py","--all","--json"],"inputs":[{"path":"tools/adapter_xlsx.py","role":"xlsx-profile-adapter"},{"path":"e2e/corpus/manifest.json","role":"corpus-manifest"}],"outputs":[{"sourcePath":"tools/adapter_xlsx.py","path":"artifacts/100/adapter_xlsx.py","role":"xlsx-profile-adapter"},{"sourcePath":"e2e/corpus/manifest.json","path":"artifacts/100/corpus-manifest.json","role":"corpus-manifest"}]},
    {"evidenceId":"issue-101-pdf-profile","issueNumbers":[101],"requirementIds":["QUAL-101-PDF-PROFILE"],"command":["python","tools/run_e2e.py","--all","--json"],"inputs":[{"path":"tools/adapter_pdf.py","role":"pdf-profile-adapter"},{"path":"e2e/corpus/manifest.json","role":"corpus-manifest"}],"outputs":[{"sourcePath":"tools/adapter_pdf.py","path":"artifacts/101/adapter_pdf.py","role":"pdf-profile-adapter"},{"sourcePath":"e2e/corpus/manifest.json","path":"artifacts/101/corpus-manifest.json","role":"corpus-manifest"}]},
    {"evidenceId":"issue-102-markdown-profile","issueNumbers":[102],"requirementIds":["QUAL-102-MARKDOWN-PROFILE"],"command":["python","tools/run_e2e.py","--all","--json"],"inputs":[{"path":"tools/adapter_markdown.py","role":"markdown-profile-adapter"},{"path":"e2e/corpus/manifest.json","role":"corpus-manifest"}],"outputs":[{"sourcePath":"tools/adapter_markdown.py","path":"artifacts/102/adapter_markdown.py","role":"markdown-profile-adapter"},{"sourcePath":"e2e/corpus/manifest.json","path":"artifacts/102/corpus-manifest.json","role":"corpus-manifest"}]},
    {"evidenceId":"issue-103-query-index","issueNumbers":[103],"requirementIds":["QUAL-103-QUERY-INDEX"],"command":["python","tools/query_qualification.py"],"inputs":[{"path":"machine/query-contract.json","role":"query-contract"},{"path":"tools/query_ir.py","role":"query-index"},{"path":"tools/query_qualification.py","role":"query-qualification"}],"outputs":[{"sourcePath":"machine/query-contract.json","path":"artifacts/103/query-contract.json","role":"query-contract"},{"sourcePath":"tools/query_ir.py","path":"artifacts/103/query_ir.py","role":"query-index"}]},
    {"evidenceId":"issue-104-independent-corpus","issueNumbers":[104],"requirementIds":["QUAL-104-INDEPENDENT-CORPUS"],"command":["python","tools/independent_corpus.py","--json"],"inputs":[{"path":"e2e/corpus/manifest.json","role":"corpus-manifest"},{"path":"tools/independent_corpus.py","role":"corpus-runner"}],"outputs":[{"sourcePath":"e2e/corpus/manifest.json","path":"artifacts/104/corpus-manifest.json","role":"corpus-manifest"},{"sourcePath":"tools/independent_corpus.py","path":"artifacts/104/independent_corpus.py","role":"corpus-runner"}]},
    {"evidenceId":"issue-105-release-quality","issueNumbers":[105],"requirementIds":["QUAL-105-RELEASE-BARRIER"],"command":["python","tools/release_gate.py"],"inputs":[{"path":"machine/release-claim-manifest.json","role":"release-claims"},{"path":"machine/audit-recovery-plan.json","role":"release-barrier"},{"path":".github/workflows/design.yml","role":"ci-workflow"},{"path":"tools/clean_room_replay.py","role":"clean-room-runner"},{"path":"e2e/.run/clean-room-replay.json","role":"clean-room-report"}],"outputs":[{"sourcePath":"machine/release-claim-manifest.json","path":"artifacts/105/release-claim-manifest.json","role":"release-claims"},{"sourcePath":"machine/audit-recovery-plan.json","path":"artifacts/105/audit-recovery-plan.json","role":"release-barrier"},{"sourcePath":".github/workflows/design.yml","path":"artifacts/105/design.yml","role":"ci-workflow"},{"sourcePath":"tools/clean_room_replay.py","path":"artifacts/105/clean_room_replay.py","role":"clean-room-runner"},{"sourcePath":"e2e/.run/clean-room-replay.json","path":"artifacts/105/clean-room-replay.json","role":"clean-room-report"}]}
  ],
  "negativeFixtures": [
    {"id":"modified-output","mutation":"append one byte to a declared output without changing its manifest record","expectedDiagnostic":"OUTPUT_DIGEST_MISMATCH"},
    {"id":"different-source-sha","mutation":"change one report sourceSha nibble and refresh only the enclosing payload metadata","expectedDiagnostic":"SOURCE_SHA_MISMATCH"},
    {"id":"empty-report","mutation":"replace one report with an empty JSON object and refresh only the enclosing payload metadata","expectedDiagnostic":"EVIDENCE_REPORT_EMPTY"},
    {"id":"ci-inconsistent","mutation":"change ci.sourceSha while keeping the report sourceSha unchanged","expectedDiagnostic":"CI_SOURCE_SHA_MISMATCH"},
    {"id":"duplicate-evidence-id","mutation":"copy a report to a second path without changing evidenceId","expectedDiagnostic":"DUPLICATE_EVIDENCE_ID"},
    {"id":"dirty-tree","mutation":"mark the manifest and report as dirty under the release-clean policy","expectedDiagnostic":"DIRTY_TREE"},
    {"id":"assertion-mismatch","mutation":"change an assertion expected value without changing actual","expectedDiagnostic":"ASSERTION_MISMATCH"},
    {"id":"manifest-digest","mutation":"change the manifest declaration without recomputing manifestDigest","expectedDiagnostic":"MANIFEST_DIGEST_MISMATCH"}
  ],
  "policies": {
    "noThirdPartyDependencies": true,
    "requireEvidenceSchemaFields": true,
    "requireInputDigestRecomputation": true,
    "requireOutputDigestRecomputation": true,
    "requireAtLeastOneAssertion": true,
    "requireAtLeastOneTestCase": true,
    "rejectDuplicateEvidenceIds": true,
    "rejectUnresolvedIssueBindings": true,
    "rejectCiSourceOrRepositoryMismatch": true,
    "rejectReleaseDirtyTree": true,
    "waiversAllowed": false
  }
}
