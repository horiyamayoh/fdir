{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:fdir:adapter-sandbox-receipt:1",
  "title": "FDIR adapter sandbox receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "launcherId",
    "launcherVersion",
    "workerId",
    "manifestDigest",
    "executableDigest",
    "policyDigest",
    "networkDenied",
    "opaqueHandlesOnly",
    "isolatedTemporaryStorage",
    "environmentCleared",
    "credentialsCleared",
    "childProcessesDenied",
    "inputReadOnly",
    "resourceLimitsEnforced"
  ],
  "properties": {
    "schema": {
      "const": "fdir/adapter-sandbox-receipt/1"
    },
    "launcherId": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "launcherVersion": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "workerId": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "manifestDigest": {
      "$ref": "#/$defs/digest"
    },
    "executableDigest": {
      "$ref": "#/$defs/digest"
    },
    "policyDigest": {
      "$ref": "#/$defs/digest"
    },
    "networkDenied": {
      "const": true
    },
    "opaqueHandlesOnly": {
      "const": true
    },
    "isolatedTemporaryStorage": {
      "const": true
    },
    "environmentCleared": {
      "const": true
    },
    "credentialsCleared": {
      "const": true
    },
    "childProcessesDenied": {
      "const": true
    },
    "inputReadOnly": {
      "const": true
    },
    "resourceLimitsEnforced": {
      "const": true
    }
  },
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\u0000-\\u001f]+$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
